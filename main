#include <iostream>
using namespace std;
// Functions to calculate the perimeter and area.
double calcPerimeter(double l, double w) {
    return (2 * l) + (2 * w);
}
double calcArea(double l, double w) {
    return l * w;
}

int main()
{
    // Declare needed variables.
    int choice = 1;
    double length = 0;
    double width = 0;
    // Repeatedly ask the user if they want to keep making more rectangles until they quit.
    while (choice != 2) {
    cout << "Would you like to calculate the perimeter of a rectangle? 1. Yes 2. Quit \n";
    cin >> choice;
    length = 0;
    width = 0;
    if (choice == 1) {
        while (length < 0.00001) {
            cout << "Please input a valid length. \n";
            cin >> length;
        }
        while (width < 0.00001) {
            cout << "Please input a valid width. \n";
            cin >> width;
        }
        // Display the rectangle's perimeter and area.
        cout << "The perimeter is " << calcPerimeter(length, width) << "\n";
        cout << "The area is " << calcArea(length, width) << "\n";
    }
    else {
        if (choice != 2) {
        cout << "Invalid choice. \n";
        }
    }
}
    return 0;
}
